<%= form_with(model: category, local: true) do |form| %>
  <% if category.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= form.label :description, class: "form-label fw-bold" %>
    <%= form.text_area :description, rows: 3, class: "form-control" %>
  </div>
  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-success" %>
    <%= link_to 'Cancel', categories_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
