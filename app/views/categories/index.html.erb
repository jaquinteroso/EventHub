<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Categories</h1>
  <% if user_signed_in? %>
    <%= link_to 'New Category', new_category_path, class: 'btn btn-primary' %>
  <% end %>
</div>

<div class="list-group">
  <% @categories.each do |category| %>
    <div class="list-group-item">
      <div class="d-flex w-100 justify-content-between align-items-center">
        <div>
          <h5 class="mb-1"><%= link_to category.name, category_path(category), class: "text-decoration-none" %></h5>
          <p class="mb-1 text-muted"><%= category.description %></p>
        </div>
        <% if user_signed_in? %>
          <div class="d-flex gap-2">
            <%= link_to 'Edit', edit_category_path(category), class: 'btn btn-sm btn-outline-secondary' %>
            <%= button_to 'Delete', category_path(category), method: :delete, class: 'btn btn-sm btn-outline-danger', data: { confirm: 'Are you sure?' } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
