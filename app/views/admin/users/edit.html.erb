<div class="card shadow-sm p-4 mx-auto" style="max-width: 640px;">
  <h1 class="fw-bold mb-4">Edit User</h1>

  <%= form_with(model: [:admin, @user], local: true) do |form| %>
    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <h5 class="alert-heading"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h5>
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :full_name, class: "form-label fw-bold" %>
      <%= form.text_field :full_name, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :email, class: "form-label fw-bold" %>
      <%= form.email_field :email, class: "form-control", required: true %>
    </div>

    <div class="mb-4">
      <%= form.label :role, class: "form-label fw-bold" %>
      <%= form.select :role, User.roles.keys.map { |role| [role.humanize, role] }, {}, class: "form-select" %>
    </div>

    <div class="d-flex gap-2">
      <%= form.submit "Update User", class: "btn btn-success" %>
      <%= link_to "Cancel", admin_users_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
