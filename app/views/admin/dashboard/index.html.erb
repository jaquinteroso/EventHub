<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold mb-1">Admin Dashboard</h1>
    <p class="text-muted mb-0">Manage EventHub moderation resources.</p>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Users</h5>
        <p class="display-6 fw-bold mb-3"><%= @users_count %></p>
        <%= link_to "Manage Users", admin_users_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Categories</h5>
        <p class="display-6 fw-bold mb-3"><%= @categories_count %></p>
        <%= link_to "Manage Categories", categories_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Venues</h5>
        <p class="display-6 fw-bold mb-3"><%= @venues_count %></p>
        <%= link_to "Manage Venues", venues_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header bg-dark text-white fw-bold">Recent Reviews</div>
  <div class="card-body">
    <% if @reviews.any? %>
      <div class="list-group list-group-flush">
        <% @reviews.each do |review| %>
          <div class="list-group-item px-0">
            <div class="d-flex justify-content-between gap-3">
              <div>
                <div class="fw-bold"><%= review.event.title %></div>
                <div class="text-muted small">
                  By <%= review.user.display_name %> · Rating <%= review.rating %>/5
                </div>
                <p class="mb-0 mt-2"><%= review.comment %></p>
              </div>
              <% if can?(:destroy, review) %>
                <div>
                  <%= button_to "Delete", event_review_path(review.event, review), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure you want to delete this review?" } %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted mb-0">No reviews have been submitted yet.</p>
    <% end %>
  </div>
</div>
