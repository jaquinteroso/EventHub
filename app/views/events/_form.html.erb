<%= form_with(model: event, local: true) do |form| %>
  <% if event.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h5>
      <ul class="mb-0">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label fw-bold" %>
    <%= form.text_field :title, class: "form-control", placeholder: "e.g., Ruby on Rails Hackathon", required: true %>
  </div>

  <div class="row mb-3">
    <div class="col-md-6">
      <%= form.label :category_id, "Category", class: "form-label fw-bold" %>
      <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a Category" }, class: "form-select", required: true %>
    </div>
    <div class="col-md-6">
      <%= form.label :venue_id, "Venue", class: "form-label fw-bold" %>
      <%= form.collection_select :venue_id, Venue.all, :id, :name, { prompt: "Select a Venue" }, class: "form-select", required: true %>
    </div>
  </div>

  <div class="row mb-3">
    <div class="col-md-4">
      <%= form.label :start_date, class: "form-label fw-bold" %>
      <%= form.datetime_field :start_date, class: "form-control", required: true %>
    </div>
    <div class="col-md-4">
      <%= form.label :end_date, class: "form-label fw-bold" %>
      <%= form.datetime_field :end_date, class: "form-control", required: true %>
    </div>
    <div class="col-md-4">
      <%= form.label :max_capacity, "Maximum Capacity", class: "form-label fw-bold" %>
      <%= form.number_field :max_capacity, class: "form-control", min: 1, required: true %>
    </div>
  </div>

  <div class="mb-4">
    <%= form.label :description, "Event Description", class: "form-label fw-bold" %>
    <%# Este helper genera el editor ActionText automáticamente %>
    <%= form.rich_text_area :description, class: "form-control bg-white", placeholder: "Write detailed information here..." %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-success px-4" %>
    <%= link_to 'Back to Events', events_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
