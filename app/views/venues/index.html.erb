<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Venues</h1>
  <% if user_signed_in? %>
    <%= link_to 'New Venue', new_venue_path, class: 'btn btn-primary' %>
  <% end %>
</div>

<table class="table table-hover table-bordered shadow-sm">
  <thead class="table-dark">
    <tr>
      <th>Name</th>
      <th>Address</th>
      <th>Max Capacity</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @venues.each do |venue| %>
      <tr>
        <td><%= venue.name %></td>
        <td><%= venue.address %></td>
        <td><%= venue.capacity_max %></td>
        <td>
          <%= link_to 'View', venue_path(venue), class: 'btn btn-sm btn-outline-primary' %>
          <% if user_signed_in? %>
            <%= link_to 'Edit', edit_venue_path(venue), class: 'btn btn-sm btn-outline-secondary' %>
            <%= button_to 'Delete', venue_path(venue), method: :delete, class: 'btn btn-sm btn-outline-danger d-inline', data: { confirm: 'Are you sure?' } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
