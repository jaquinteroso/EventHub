<%= form_with(model: venue, local: true) do |form| %>
  <% if venue.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% venue.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= form.label :address, class: "form-label fw-bold" %>
    <%= form.text_field :address, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= form.label :capacity_max, "Maximum Capacity", class: "form-label fw-bold" %>
    <%= form.number_field :capacity_max, class: "form-control", min: 1, required: true %>
  </div>
  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-success" %>
    <%= link_to 'Cancel', venues_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
